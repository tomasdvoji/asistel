---
import Base from '../layouts/Base.astro';
import k from '../data/editable/kariera.json';
import pozice from '../data/editable/pozice.json';
const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith('/') ? baseRaw.slice(0, -1) : baseRaw;
---
<Base title={`${k.title} — Asistel s.r.o`} description={k.intro}>
  <section class="section page-head">
    <div class="container">
      <span class="eyebrow">{k.eyebrow}</span>
      <h1 class="grad-text">{k.title}</h1>
      <p class="muted">{k.intro}</p>
      {pozice.items.length > 0 && (
      <p style="margin-top:18px"><a class="btn btn-primary" href="#pozice">Aktuálně volné pozice ↓</a></p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container job">
      {pozice.items.length > 0 && (
      <div class="job-section" id="pozice" data-reveal>
        <h2>Aktuálně volné pozice</h2>
        <div class="pozice-grid">
          {pozice.items.map((p) => (
            <a class="card pozice-card" href={`${base}/kariera/${p.id}`}>
              <h3>{p.title}</h3>
              <p class="muted">{p.misto} · {p.typ}</p>
              <span class="btn btn-ghost">Detail a přihláška</span>
            </a>
          ))}
        </div>
      </div>
      )}

      <div class="card job-contact" data-reveal>
        <h2 class="grad-text">{k.contactHeading}</h2>
        {k.email && <p>{k.contactEmailLabel} <a href={`mailto:${k.email}`}>{k.email}</a></p>}
        {k.phone && <p>{k.contactPhoneLabel} <a href={`tel:${k.phone.replace(/\s/g, '')}`}>{k.phone}</a></p>}
        {!k.email && !k.phone && <p class="muted">Kontakty brzy doplníme — zatím se podívejte na naše nabídky níže.</p>}
      </div>

      {k.sections.map((sec) => (
        <div class="job-section" data-reveal>
          <h2>{sec.heading}</h2>
          <ul class="job-list">
            {sec.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}

      <p class="job-cta" data-reveal>
        <a class="btn btn-primary" href={k.praceUrl} target="_blank" rel="noopener">{k.praceLabel}</a>
      </p>
    </div>
  </section>
</Base>
