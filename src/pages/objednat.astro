---
import Base from '../layouts/Base.astro';
import shops from '../data/editable/shops.json';
import cfg from '../data/editable/objednat.json';

// Časy po půlhodině 9:00–18:00 — konkrétní otevírací dobu si ověří prodejna.
const times: string[] = [];
for (let h = 9; h < 18; h++) times.push(`${h}:00`, `${h}:30`);
times.push('18:00');

// E-maily prodejen se do HTML nedávají přímo (spam boti) — jen id a jméno,
// adresy si vezme skript z JSONu níže zakódované v base64.
const shopMeta = shops.items.map((s) => ({ id: s.id, name: s.name, email: s.email || cfg.fallbackEmail, address: s.address, hours: s.hours }));
const shopMetaB64 = Buffer.from(JSON.stringify(shopMeta), 'utf8').toString('base64');
---
<Base title={`${cfg.title} — Asistel s.r.o`} description={cfg.lead}>
  <section class="section page-head">
    <div class="container">
      <span class="eyebrow">{cfg.eyebrow}</span>
      <h1 class="grad-text">{cfg.title}</h1>
      <p class="muted">{cfg.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container booking">
      <form class="card booking-form" id="booking-form" novalidate>
        <div class="form-row">
          <div class="form-field">
            <label for="bf-shop">Prodejna *</label>
            <select id="bf-shop" name="prodejna" required>
              {shops.items.map((s) => <option value={s.id}>{s.name}</option>)}
            </select>
          </div>
          <div class="form-field">
            <label for="bf-date">Den *</label>
            <input id="bf-date" name="datum" type="date" required>
          </div>
          <div class="form-field">
            <label for="bf-time">Čas *</label>
            <select id="bf-time" name="cas" required>
              {times.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div class="form-field">
          <label for="bf-desc">S čím vám pomůžeme? *</label>
          <textarea id="bf-desc" name="popis" rows="4" required placeholder="Např. výběr nového telefonu, změna tarifu, reklamace…"></textarea>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="bf-name">Jméno a příjmení *</label>
            <input id="bf-name" name="jmeno" type="text" autocomplete="name" required>
          </div>
          <div class="form-field">
            <label for="bf-phone">Telefon *</label>
            <input id="bf-phone" name="telefon" type="tel" autocomplete="tel" required>
          </div>
          <div class="form-field">
            <label for="bf-email">E-mail *</label>
            <input id="bf-email" name="email" type="email" autocomplete="email" required>
          </div>
        </div>
        <p class="form-error muted" id="bf-error" hidden>{cfg.errorText}</p>
        <p style="margin-top:8px"><button class="btn btn-primary" type="submit" id="bf-submit">Objednat se</button></p>
      </form>

      <div class="card booking-success" id="booking-success" hidden data-reveal-skip>
        <h2 class="grad-text">{cfg.successHeading}</h2>
        <p id="bs-summary"></p>
        <p class="muted" style="margin-top:10px">{cfg.successText}</p>
        <p style="margin-top:14px">
          <a class="btn btn-primary" id="bs-gcal" target="_blank" rel="noopener">Přidat do Google Kalendáře</a>
          <a class="btn" id="bs-ics" download="objednavka-asistel.ics">Stáhnout do kalendáře (.ics)</a>
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="booking-data" set:html={JSON.stringify({ shopsB64: shopMetaB64, autoIntro: cfg.autoReplyIntro, autoOutro: cfg.autoReplyOutro, ejs: { service: cfg.emailjsService, template: cfg.emailjsTemplate, key: cfg.emailjsPublicKey } })} />
  <script is:inline>
    (function () {
      var form = document.getElementById('booking-form');
      if (!form) return;
      var data = JSON.parse(document.getElementById('booking-data').textContent);
      // atob vraci bajty jako latin1 — UTF-8 (ceske znaky) je nutne dekodovat pres TextDecoder
      var shops = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(data.shopsB64), function (c) { return c.charCodeAt(0); })));

      // predvyber prodejny z ?prodejna=id + minimalni datum = dnesek
      var pre = new URLSearchParams(location.search).get('prodejna');
      if (pre) form.prodejna.value = pre;
      form.datum.min = new Date().toISOString().slice(0, 10);

      // Obsazenost terminu: max 2 rezervace na prodejnu a cas (Cloudflare Worker)
      var API = 'https://rezervace.webshowcase-tomas.workers.dev';
      var SITE = 'asistel';
      function slotKey() { return SITE + ':' + form.prodejna.value + ':' + form.datum.value; }
      function refreshSlots() {
        if (!form.datum.value) return;
        fetch(API + '/slots?key=' + encodeURIComponent(slotKey()))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            Array.prototype.forEach.call(form.cas.options, function (o) {
              var full = (d[o.value] || 0) >= 2;
              o.disabled = full;
              o.textContent = o.value + (full ? ' — obsazeno' : '');
            });
            if (form.cas.selectedOptions[0] && form.cas.selectedOptions[0].disabled) {
              var free = Array.prototype.find.call(form.cas.options, function (o) { return !o.disabled; });
              if (free) form.cas.value = free.value;
            }
          })
          .catch(function () {}); // kdyz sluzba nejede, formular funguje dal
      }
      function reserveSlot() {
        return fetch(API + '/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: slotKey(), time: form.cas.value })
        }).then(function (r) {
          if (r.status === 409) { var e = new Error('slot_full'); e.slotFull = true; throw e; }
        }).catch(function (e) { if (e.slotFull) throw e; }); // vypadek sluzby rezervaci neblokuje
      }
      form.prodejna.addEventListener('change', refreshSlots);
      form.datum.addEventListener('change', refreshSlots);

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var shop = shops.find(function (s) { return s.id === form.prodejna.value; }) || shops[0];
        var d = form.datum.value.split('-');
        var dateCz = d[2] + '. ' + d[1] + '. ' + d[0];
        var summary = 'Prodejna ' + shop.name + ', ' + dateCz + ' v ' + form.cas.value + ' hod.';

        // termin = 30min slot; casy pro kalendar v lokalnim tvaru bez zony
        var t = form.cas.value.split(':');
        var start = new Date(form.datum.value + 'T' + ('0' + t[0]).slice(-2) + ':' + t[1] + ':00');
        var end = new Date(start.getTime() + 30 * 60000);
        function fmt(dt) {
          return dt.getFullYear() + ('0' + (dt.getMonth() + 1)).slice(-2) + ('0' + dt.getDate()).slice(-2) +
            'T' + ('0' + dt.getHours()).slice(-2) + ('0' + dt.getMinutes()).slice(-2) + '00';
        }
        var evTitle = 'Asistel — objednávka: ' + shop.name;
        var gcalUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE' +
          '&text=' + encodeURIComponent(evTitle) +
          '&dates=' + fmt(start) + '/' + fmt(end) +
          '&location=' + encodeURIComponent(shop.address) +
          '&details=' + encodeURIComponent(form.popis.value);

        var btn = document.getElementById('bf-submit');
        var errEl = document.getElementById('bf-error');
        if (!errEl.dataset.base) errEl.dataset.base = errEl.textContent;
        btn.disabled = true;
        btn.textContent = 'Odesílám…';
        errEl.hidden = true;

        // ---------- HTML e-maily pres EmailJS ----------
        function esc(s) {
          return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        }
        var MAGENTA = '#E20074';
        function row(label, value) {
          return '<tr><td style="padding:10px 14px;border-bottom:1px solid #eee;color:#888;font-size:13px;white-space:nowrap">' + label + '</td>' +
            '<td style="padding:10px 14px;border-bottom:1px solid #eee;color:#262626;font-size:14px">' + value + '</td></tr>';
        }
        function button(href, text) {
          return '<a href="' + href + '" style="display:inline-block;background:' + MAGENTA + ';color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;padding:12px 28px;border-radius:999px">' + text + '</a>';
        }
        function wrap(heading, inner) {
          return '<div style="margin:0 auto;max-width:560px;font-family:Arial,Helvetica,sans-serif;background:#ffffff;border:1px solid #eeeeee;border-radius:12px;overflow:hidden">' +
            '<div style="background:' + MAGENTA + ';padding:18px 24px;color:#ffffff;font-size:18px;font-weight:bold">Asistel <span style="opacity:.7">|</span> T&#8209;Mobile partner</div>' +
            '<div style="padding:24px"><h2 style="margin:0 0 16px;font-size:20px;color:#262626">' + heading + '</h2>' + inner + '</div>' +
            '<div style="padding:14px 24px;background:#fafafa;color:#999;font-size:12px">Asistel s.r.o &middot; partnersk&eacute; prodejny T&#8209;Mobile</div></div>';
        }

        var infoTable = '<table cellpadding="0" cellspacing="0" style="width:100%;border:1px solid #eee;border-radius:8px;border-collapse:separate;margin:0 0 20px">' +
          row('Prodejna', esc(shop.name)) +
          row('Den', esc(dateCz)) +
          row('Čas', esc(form.cas.value) + ' hod.') +
          row('Popis', esc(form.popis.value)) +
          row('Jméno', esc(form.jmeno.value)) +
          row('Telefon', esc(form.telefon.value)) +
          row('E-mail', esc(form.email.value)) +
          '</table>';


        // odkaz na stranku, kde zamestnanec objednavku potvrdi (posle zakaznikovi finalni potvrzeni)
        var payload = {
          c: form.email.value, n: form.jmeno.value, d: dateCz, t: form.cas.value, p: form.popis.value, g: gcalUrl,
          s: { name: shop.name, address: shop.address, hours: shop.hours, email: shop.email }
        };
        var payloadB64 = btoa(String.fromCharCode.apply(null, new TextEncoder().encode(JSON.stringify(payload))));
        var confirmUrl = location.href.split('?')[0].replace(/\/objednat.*$/, '/potvrdit') + '?d=' + encodeURIComponent(payloadB64);

        var shopHtml = wrap('Zákazník objednán k nám na prodejnu', infoTable +
          '<p style="color:#444;font-size:14px;line-height:1.6;margin:0 0 14px">Zákazník zatím dostal jen zprávu, že rezervaci evidujeme. Kliknutím na tlačítko mu odešlete potvrzení termínu:</p>' +
          '<div style="text-align:center;margin:4px 0 16px">' + button(confirmUrl, 'Potvrdit termín') + '</div>' +
          '<div style="text-align:center;margin:0 0 8px"><a href="' + gcalUrl + '" style="color:' + MAGENTA + ';font-size:14px">Přidat do kalendáře</a></div>');


        var custTable = '<table cellpadding="0" cellspacing="0" style="width:100%;border:1px solid #eee;border-radius:8px;border-collapse:separate;margin:0 0 20px">' +
          row('Prodejna', esc(shop.name)) +
          (shop.address ? row('Adresa', esc(shop.address)) : '') +
          row('Den', esc(dateCz)) +
          row('Čas', esc(form.cas.value) + ' hod.') +
          (shop.hours ? row('Otevírací doba', esc(shop.hours)) : '') +
          row('S čím pomůžeme', esc(form.popis.value)) +
          '</table>';

        var custHtml = wrap('Přijali jsme Vaši rezervaci',
          '<p style="color:#444;font-size:14px;line-height:1.6;margin:0 0 18px">Dobrý den,<br>děkujeme za Vaši rezervaci. Předali jsme ji prodejně — jakmile termín potvrdí, přijde Vám e-mail s potvrzením.</p>' +
          custTable +
          '<p style="color:#444;font-size:14px;line-height:1.6;margin:0">' + esc(data.autoOutro).replace(/\n/g, '<br>') + '</p>');

        function sendMail(params) {
          return fetch('https://api.emailjs.com/api/v1.0/email/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ service_id: data.ejs.service, template_id: data.ejs.template, user_id: data.ejs.key, template_params: params })
          }).then(function (r) {
            if (!r.ok) return r.text().then(function (t) { var e = new Error('send failed'); e.detail = t || ('HTTP ' + r.status); throw e; });
          });
        }

        reserveSlot().then(function () {
        return sendMail({
          to_email: shop.email,
          reply_to: form.email.value,
          subject: 'Zákazník objednán k nám na prodejnu',
          html_body: shopHtml
        });
        }).then(function () {
          // potvrzeni zakaznikovi — kdyz selze, objednavka uz je u prodejny, nezobrazujeme chybu
          return sendMail({
            to_email: form.email.value,
            reply_to: shop.email,
            subject: 'Potvrzení Vaší návštěvy prodejny T-Mobile',
            html_body: custHtml
          }).catch(function (err) { console.error('Potvrzení zákazníkovi se neodeslalo:', err && err.detail); });
        })
          .then(function () {
            document.getElementById('bs-summary').textContent = summary;
            document.getElementById('bs-gcal').href = gcalUrl;
            var ics = 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Asistel//objednavka//CS\r\nBEGIN:VEVENT\r\n' +
              'UID:' + fmt(start) + '-' + shop.id + '@asistel\r\n' +
              'DTSTAMP:' + fmt(start) + '\r\nDTSTART:' + fmt(start) + '\r\nDTEND:' + fmt(end) + '\r\n' +
              'SUMMARY:' + evTitle + '\r\nLOCATION:' + shop.address + '\r\n' +
              'DESCRIPTION:' + form.popis.value.replace(/\n/g, '\\n') + '\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n';
            document.getElementById('bs-ics').href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
            form.hidden = true;
            document.getElementById('booking-success').hidden = false;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          })
          .catch(function (err) {
            if (err && err.slotFull) {
              errEl.textContent = 'Tento čas je už bohužel plně obsazený. Vyberte si prosím jiný termín.';
              errEl.hidden = false;
              btn.disabled = false;
              btn.textContent = 'Objednat se';
              refreshSlots();
              return;
            }
            console.error('Objednávka se neodeslala:', err && err.detail ? err.detail : err);
            errEl.textContent = errEl.dataset.base + (err && err.detail ? ' [' + err.detail + ']' : '');
            errEl.hidden = false;
            btn.disabled = false;
            btn.textContent = 'Objednat se';
          });
      });
    })();
  </script>
</Base>
